# Server-side only — read by app/api/illuminate+api.ts. Never prefix this
# with EXPO_PUBLIC_ or it will be bundled into the client JS/app binary.
ANTHROPIC_API_KEY=

# Native builds only. The web build calls /api/illuminate on its own origin,
# but native apps have no origin, so point this at your deployed server,
# e.g. https://lightbulb.example.com
EXPO_PUBLIC_API_BASE_URL=

# Server-side feature flag, read by app/api/flags+api.ts. Unset/anything
# other than "true" means off. Toggle this on Render (env var + restart) to
# flip Reddit back on for every client without a redeploy or app-store review.
FEATURE_REDDIT_ENABLED=

# Optional. Shared fact/relevance cache for /api/illuminate (see
# utils/sharedCache.ts) - a free Upstash Redis database's REST credentials.
# Without these, the route falls back to an in-memory cache that resets on
# every restart/redeploy/spin-down instead of persisting across them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
